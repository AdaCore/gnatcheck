procedure Loop1 (Str : in out String) is
begin
   for J of Str loop
      -- FLAG
      if J = ' ' then
         return;
      elsif J = 'a' then
         exit;
      end if;
   end loop;

   for J of Str loop
      -- FLAG
      J := ' ';
   end loop;

   for J in Str'Range loop  -- NOFLAG
      exit when J > 1;
   end loop;

   declare
      Str2 : constant String := Str;
   begin
      for J in Str'Range loop  -- NOFLAG
         Str (J) := Str2 (J);
      end loop;
   end;
end Loop1;

Patched "loop2.adb":
